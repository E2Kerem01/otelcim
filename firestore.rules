rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Prevent regular users from tampering with their isAdmin field
    function isNotChangingAdminStatus() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) || isAdmin();
    }

    // Public job marketplace listings. Read is public so anonymous users can
    // browse (home feed, regions, map, nearby). Writes require ownership;
    // moderation (update/delete) is also allowed for admins.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.posterId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.posterId) || isAdmin();

      // Contact details (phone/email) are split out from the listing doc
      // above, which is publicly readable, so anonymous users can't read
      // them straight off the wire by fetching the listing. Any signed-in
      // user may read (matches the in-app "sign in to reveal contact
      // info" UX); only the listing's owner or an admin may write it.
      match /private/contact {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          (get(/databases/$(database)/documents/listings/$(listingId)).data.posterId == request.auth.uid ||
           isAdmin());
      }
    }

    // Public profile data (hotel name, verified badge, bio) shown on
    // listings and chat. Only the owner can write their own profile.
    match /user_profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) &&
        (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false || isAdmin());
      allow update: if (isOwner(userId) || isAdmin()) && isNotChangingAdminStatus();
      allow delete: if isOwner(userId) || isAdmin();

      match /favorites/{listingId} {
        allow read, write: if isOwner(userId);
      }

      match /seasonal_subscriptions/{subscriptionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy collection, only touched during account-deletion cleanup.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Chat. Only participants or admins can read conversations and messages.
    match /conversations/{conversationId} {
      allow read: if isSignedIn() &&
        (resource.data.posterId == request.auth.uid ||
         resource.data.seekerId == request.auth.uid ||
         isAdmin());
      allow create: if isSignedIn() &&
        (request.resource.data.posterId == request.auth.uid ||
         request.resource.data.seekerId == request.auth.uid);
      allow update: if isSignedIn() &&
        (resource.data.posterId == request.auth.uid ||
         resource.data.seekerId == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['posterId', 'seekerId']);

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.posterId == request.auth.uid ||
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.seekerId == request.auth.uid ||
           isAdmin());
        allow create: if isSignedIn() &&
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.posterId == request.auth.uid ||
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.seekerId == request.auth.uid);
      }

      // Interview time proposals/confirmations, scoped to conversation participants.
      match /interview_slots/{slotId} {
        allow read, write: if isSignedIn() &&
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.posterId == request.auth.uid ||
           get(/databases/$(database)/documents/conversations/$(conversationId)).data.seekerId == request.auth.uid);
      }
    }

    // Reports are write-only for regular users (their own report), only
    // admins can list/review them.
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    // Employer verification requests.
    match /verification_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.employerId == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.employerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Boosts / purchases. Reads are scoped to the owner (or admin) — these
    // contain purchase/pricing data. Direct client-side creates/updates of
    // paid boosts are disabled; paid purchases must go through the
    // verifyAndProcessBoostPurchase Cloud Function (Admin SDK, bypasses
    // these rules). Only the zero-cost referral reward path is allowed
    // directly from the client.
    match /boosts/{boostId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.platform == 'referral_reward' &&
        request.resource.data.price == 0;
    }
    match /boost_purchases/{purchaseId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.platform == 'referral_reward' &&
        request.resource.data.price == 0;
    }

    // Ratings are publicly visible (shown on profiles), only the rater can
    // create their own rating document, for someone else, with a valid
    // 1-5 score.
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.raterId == request.auth.uid &&
        request.resource.data.ratedUserId != request.auth.uid &&
        request.resource.data.stars is number &&
        request.resource.data.stars >= 1 &&
        request.resource.data.stars <= 5;
    }

    // Certificate wallet: owner reads/creates their own certificates; admin
    // can read any (needed for the pending-review query) and is the only
    // one who can update status (approve/reject).
    match /certificates/{certId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Sponsor banners: public read, admin-managed.
    match /banner_ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Flat mirror of seasonal subscriptions used only as a Cloud Function
    // trigger source (read via Admin SDK, bypasses these rules). Client
    // only ever creates/updates/deletes its own entry here.
    match /seasonal_subscriptions/{subscriptionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // Admin-only collections.
    match /admin_audit_log/{logId} {
      allow read, write: if isAdmin();
    }

    // Default deny for anything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

