<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Otelcim</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>otelcim</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- App Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>Otelcim profil fotoğrafı yüklemek ve otel görselleri çekmek için kameraya erişim istiyor.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Otelcim galerinize erişerek fotoğraf seçmenize izin verir.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Otelcim video çekimi esnasında ses kaydı almak için mikrofona erişim istiyor.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Otelcim yakındaki iş ilanlarını göstermek ve ilanınıza isteğe bağlı konum eklemek için konumunuza erişir.</string>
	<!-- External URL Launcher Schemes -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>mailto</string>
	</array>
	<!-- In-App Purchase Configuration -->
	<!-- StoreKit functionality requires In-App Purchase capability to be enabled in Xcode -->
	<!-- For local testing, use Configuration.storekit file with StoreKit Testing -->
	<!-- No additional Info.plist keys required for basic IAP functionality -->
	<key>SKAdNetworkItems</key>
	<array>
		<!-- Reserved for future ad network attribution if needed -->
	</array>
</dict>
</plist>
